# Server
PORT=3000
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://dealer_crm:dealer_crm_dev_password@localhost:5432/dealer_crm

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Application-level column encryption (credit_limit, current_balance, price)
# Must be a 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=replace-with-meta-permanent-or-system-user-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_VERIFY_TOKEN=replace-with-a-string-you-choose
WHATSAPP_API_VERSION=v21.0

# LLM (Anthropic)
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
# Only needed if ANTHROPIC_API_KEY is an org-scoped (not workspace-scoped) key
ANTHROPIC_WORKSPACE_ID=
LLM_MODEL=claude-haiku-4-5

# Data retention
CONVERSATION_RETENTION_DAYS=90

# Escalation thresholds
# Escalate an order if quantity exceeds this many units in a single line item
ESCALATION_MAX_QUANTITY_UNITS=500
# Escalate if the LLM's own confidence in intent/entity extraction is below this
ESCALATION_MIN_CONFIDENCE=0.75
